      "local_id": "D6",
      "local_label": "Section 2.2 — Cumulative dependence (2.4)",
      "source_heading": "Section 2.2 — Cumulative dependence (2.4)",
      "source_kind": "definition",
      "statement_original": "we will express our dependence condition in terms of\n\\[\n\\Theta_{i,p}=\\sum_{k=i}^\\infty\\delta_p(k),\\quad i\\ge0.\n\\]\n(2.4)",
      "relation": "exact",
      "depends_on": [
        "D5"
      ],
      "evidence": [
