    {
      "paper_id": "aos-2024-v52-i05-p2293",
      "local_id": "D7",
      "local_label": "Condition 2.1",
      "source_heading": "Condition 2.1",
      "source_kind": "condition",
      "statement_original": "Consider (1.2). Suppose that $\\Theta_{0,p}<\\infty$ for some $p>2$. Assume there exists $A>1$ and constant $C>0$, such that the uniform dependency-adjusted norm\n\\[\n\\mu_{p,A}:=\\sup_{i\\ge0}(i+1)^A\\Theta_{i,p}\\le C<\\infty.\n\\]\n(2.5)",
      "relation": "exact",
      "depends_on": [
        "D2",
        "D6"
      ],
      "evidence": [
        {
          "page": 6,
          "location": "Condition 2.1"
        }
      ],
      "highlight_symbols": [
        "\\mu_{p,A}",
        "(i+1)^A\\Theta_{i,p}"
      ],
      "highlight_phrases": []
    },
    {
      "paper_id": "aos-2024-v52-i05-p2293",
      "local_id": "D8",
      "local_label": "Condition 2.2",
      "source_heading": "Condition 2.2",
      "source_kind": "condition",
      "statement_original": "For the same $p$ as in Condition 2.1, the series $(|X_i|^p)$ satisfies the truncated uniform integrability condition:\nFor any fixed $a>0$, $\\sup_i\\mathbb E(|X_i|^p\\mathbb I_{\\{|X_i|^p\\ge an\\}})\\to0$ as $n\\to\\infty$.",
      "relation": "exact",
      "depends_on": [
        "D1"
      ],
      "evidence": [
        {
          "page": 6,
          "location": "Condition 2.2"
        }
      ],
      "highlight_symbols": [
        "\\sup_i\\mathbb E(|X_i|^p\\mathbb I_{\\{|X_i|^p\\ge an\\}})"
      ],
      "highlight_phrases": []
    },
    {
      "paper_id": "aos-2024-v52-i05-p2293",
      "local_id": "D9",
      "local_label": "Condition 2.3",
      "source_heading": "Condition 2.3",
      "source_kind": "condition",
      "statement_original": "For all sequences $(m_n)\\in\\mathbb N$ with $m_n\\to\\infty$ and $m_n<n$, the process $(X_i)$ satisfies that $\\lim_{n\\to\\infty}\\min_{1\\le i\\le n-m_n}\\|X_i+\\ldots+X_{i+m_n}\\|^2=\\infty$.",
      "relation": "exact",
      "depends_on": [
        "D1"
      ],
      "evidence": [
        {
          "page": 6,
          "location": "Condition 2.3"
        }
      ],
      "highlight_symbols": [
        "\\|X_i+\\ldots+X_{i+m_n}\\|^2"
      ],
      "highlight_phrases": [],
