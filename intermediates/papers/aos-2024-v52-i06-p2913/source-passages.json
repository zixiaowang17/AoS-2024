      ],
      "highlight_phrases": []
    },
    {
      "paper_id": "aos-2024-v52-i06-p2913",
      "local_id": "D22",
      "local_label": "Condition 3.1",
      "source_heading": "Condition 3.1",
      "source_kind": "condition",
      "statement_original": "$(Z_i)_{i\\in\\mathbb Z}$ satisfies that the $\\theta$-th moment $H_\\theta:=(\\mathbb E|Z_i|^\\theta)^{1/\\theta}<\\infty$, where $\\theta>2$. Assume that any one of the following holds\n• $\\theta>4$ and $\\Theta_{n,\\theta}=O(n^{-\\gamma_\\theta}(\\log n)^{-A})$, as $n\\to\\infty$, for $A>2(1/\\theta+1+\\gamma_\\theta)/3$, where\n\\[\n\\gamma_\\theta=(\\theta^2-4+(\\theta-2)\\sqrt{\\theta^2+20\\theta+4})/(8\\theta);\n\\]\n• $2<\\theta\\le4$ and $\\Theta_{n,\\theta}=O(n^{-1}(\\log n)^{-A})$, as $n\\to\\infty$, with $A>3/2$.",
      "relation": "exact",
      "depends_on": [
        "D19",
        "D21"
      ],
      "evidence": [
